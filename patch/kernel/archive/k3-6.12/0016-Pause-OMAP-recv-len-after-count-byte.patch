From 96ed9b94dc502db24371d2d5adaedb95b6df6597 Mon Sep 17 00:00:00 2001
From: ChatGPT Codex <codex@beagleboard.org>
Date: Thu, 7 May 2026 13:53:30 +0000
Subject: [PATCH] Pause OMAP recv-len after count byte

---
 drivers/i2c/busses/i2c-omap.c | 132 ++++++++++++++++++++++++++++++++++--------
 1 file changed, 108 insertions(+), 24 deletions(-)

diff --git a/drivers/i2c/busses/i2c-omap.c b/drivers/i2c/busses/i2c-omap.c
index 6cc241563fed..8ef6466cf339 100644
--- a/drivers/i2c/busses/i2c-omap.c
+++ b/drivers/i2c/busses/i2c-omap.c
@@ -1165,15 +1165,28 @@ static int errata_omap3_i462(struct omap_i2c_dev *omap)
 	return 0;
 }
 
-static void omap_i2c_receive_data(struct omap_i2c_dev *omap, u8 num_bytes,
+static bool omap_i2c_receive_data(struct omap_i2c_dev *omap, u8 num_bytes,
 		bool is_rdr)
 {
 	u16		w;
+	bool		recv_len_reprogrammed = false;
 
 	while (num_bytes--) {
+		size_t offset = 0;
+
 		w = omap_i2c_read_reg(omap, OMAP_I2C_DATA_REG);
 		*omap->buf++ = w;
 		omap->buf_len--;
+		if (omap->msg)
+			offset = omap->buf - omap->msg->buf;
+
+		if (omap->msg && omap->msg->flags & I2C_M_RECV_LEN)
+			dev_info_ratelimited(omap->dev,
+					     "recv-len byte value=%#02x offset=%zu buf_len=%zu cnt=%#04x bufstat=%#04x rdr=%u recv_len=%u\n",
+					     w & 0xff, offset, omap->buf_len,
+					     omap_i2c_read_reg(omap, OMAP_I2C_CNT_REG),
+					     omap_i2c_read_reg(omap, OMAP_I2C_BUFSTAT_REG),
+					     is_rdr, omap->recv_len);
 
 		if (omap->recv_len && omap->msg &&
 		    omap->buf == omap->msg->buf + 1) {
@@ -1181,17 +1194,29 @@ static void omap_i2c_receive_data(struct omap_i2c_dev *omap, u8 num_bytes,
 			size_t remaining;
 
 			if (block_len == 0 || block_len > I2C_SMBUS_BLOCK_MAX) {
+				dev_info_ratelimited(omap->dev,
+						     "recv-len invalid count=%u extra=%u buf_len=%zu\n",
+						     block_len, omap->recv_len_extra,
+						     omap->buf_len);
 				omap->recv_len_err = -EPROTO;
 				omap->recv_len = false;
-				continue;
+				recv_len_reprogrammed = true;
+				break;
 			}
 
 			remaining = block_len + omap->recv_len_extra;
 			omap->msg->len = 1 + remaining;
-			omap->buf_len = remaining;
-			omap_i2c_resize_fifo(omap, remaining, true);
-			omap_i2c_write_reg(omap, OMAP_I2C_CNT_REG, remaining);
+			dev_info_ratelimited(omap->dev,
+					     "recv-len count=%u extra=%u remaining=%zu msg_len=%u keep_buf_len=%zu cnt=%#04x threshold=%u bufstat=%#04x\n",
+					     block_len, omap->recv_len_extra,
+					     remaining, omap->msg->len,
+					     omap->buf_len,
+					     omap_i2c_read_reg(omap, OMAP_I2C_CNT_REG),
+					     omap->threshold,
+					     omap_i2c_read_reg(omap, OMAP_I2C_BUFSTAT_REG));
 			omap->recv_len = false;
+			recv_len_reprogrammed = true;
+			break;
 		}
 
 		/*
@@ -1203,6 +1228,8 @@ static void omap_i2c_receive_data(struct omap_i2c_dev *omap, u8 num_bytes,
 			omap->buf_len--;
 		}
 	}
+
+	return recv_len_reprogrammed;
 }
 
 static int omap_i2c_transmit_data(struct omap_i2c_dev *omap, u8 num_bytes,
@@ -1248,11 +1275,26 @@ static int omap_i2c_xfer_data(struct omap_i2c_dev *omap)
 		stat = omap_i2c_read_reg(omap, OMAP_I2C_STAT_REG);
 		stat &= bits;
 
-		/* If we're in receiver mode, ignore XDR/XRDY */
-		if (omap->receiver)
-			stat &= ~(OMAP_I2C_STAT_XDR | OMAP_I2C_STAT_XRDY);
-		else
-			stat &= ~(OMAP_I2C_STAT_RDR | OMAP_I2C_STAT_RRDY);
+		/*
+		 * Only service data-ready interrupts for the active transfer
+		 * direction. Clear stale opposite-direction status so it cannot
+		 * retrigger the threaded IRQ after we intentionally ignore it.
+		 */
+		if (omap->receiver) {
+			u16 tx_stat = stat & (OMAP_I2C_STAT_XDR |
+					      OMAP_I2C_STAT_XRDY);
+
+			if (tx_stat)
+				omap_i2c_ack_stat(omap, tx_stat);
+			stat &= ~tx_stat;
+		} else {
+			u16 rx_stat = stat & (OMAP_I2C_STAT_RDR |
+					      OMAP_I2C_STAT_RRDY);
+
+			if (rx_stat)
+				omap_i2c_ack_stat(omap, rx_stat);
+			stat &= ~rx_stat;
+		}
 
 		if (!stat) {
 			/* my work here is done */
@@ -1282,14 +1324,7 @@ static int omap_i2c_xfer_data(struct omap_i2c_dev *omap)
 			omap_i2c_ack_stat(omap, OMAP_I2C_STAT_AL);
 		}
 
-		/*
-		 * ProDB0017052: Clear ARDY bit twice
-		 */
-		if (stat & OMAP_I2C_STAT_ARDY)
-			omap_i2c_ack_stat(omap, OMAP_I2C_STAT_ARDY);
-
-		if (stat & (OMAP_I2C_STAT_ARDY | OMAP_I2C_STAT_NACK |
-					OMAP_I2C_STAT_AL)) {
+		if (stat & (OMAP_I2C_STAT_NACK | OMAP_I2C_STAT_AL)) {
 			omap_i2c_ack_stat(omap, (OMAP_I2C_STAT_RRDY |
 						OMAP_I2C_STAT_RDR |
 						OMAP_I2C_STAT_XRDY |
@@ -1300,8 +1335,11 @@ static int omap_i2c_xfer_data(struct omap_i2c_dev *omap)
 
 		if (stat & OMAP_I2C_STAT_RDR) {
 			u8 num_bytes = 1;
+			bool recv_len_reprogrammed;
 
-			if (omap->fifo_size)
+			if (omap->recv_len)
+				num_bytes = 1;
+			else if (omap->fifo_size)
 				num_bytes = omap->buf_len;
 
 			if (omap->errata & I2C_OMAP_ERRATA_I207) {
@@ -1310,23 +1348,69 @@ static int omap_i2c_xfer_data(struct omap_i2c_dev *omap)
 					OMAP_I2C_BUFSTAT_REG) >> 8) & 0x3F;
 			}
 
-			omap_i2c_receive_data(omap, num_bytes, true);
+			if (omap->msg && omap->msg->flags & I2C_M_RECV_LEN)
+				dev_info_ratelimited(omap->dev,
+						     "recv-len RDR stat=%#04x num=%u buf_len=%zu cnt=%#04x threshold=%u bufstat=%#04x recv_len=%u\n",
+						     stat, num_bytes, omap->buf_len,
+						     omap_i2c_read_reg(omap, OMAP_I2C_CNT_REG),
+						     omap->threshold,
+						     omap_i2c_read_reg(omap, OMAP_I2C_BUFSTAT_REG),
+						     omap->recv_len);
+
+			recv_len_reprogrammed =
+				omap_i2c_receive_data(omap, num_bytes, true);
 			omap_i2c_ack_stat(omap, OMAP_I2C_STAT_RDR);
+			if (recv_len_reprogrammed) {
+				err = -EAGAIN;
+				break;
+			}
 			continue;
 		}
 
 		if (stat & OMAP_I2C_STAT_RRDY) {
 			u8 num_bytes = 1;
+			bool recv_len_reprogrammed;
 
-			if (omap->threshold)
+			if (omap->recv_len)
+				num_bytes = 1;
+			else if (omap->threshold)
 				num_bytes = omap->threshold;
 
-			omap_i2c_receive_data(omap, num_bytes, false);
+			if (omap->msg && omap->msg->flags & I2C_M_RECV_LEN)
+				dev_info_ratelimited(omap->dev,
+						     "recv-len RRDY stat=%#04x num=%u buf_len=%zu cnt=%#04x threshold=%u bufstat=%#04x recv_len=%u\n",
+						     stat, num_bytes, omap->buf_len,
+						     omap_i2c_read_reg(omap, OMAP_I2C_CNT_REG),
+						     omap->threshold,
+						     omap_i2c_read_reg(omap, OMAP_I2C_BUFSTAT_REG),
+						     omap->recv_len);
+
+			recv_len_reprogrammed =
+				omap_i2c_receive_data(omap, num_bytes, false);
 			omap_i2c_ack_stat(omap, OMAP_I2C_STAT_RRDY);
+			if (recv_len_reprogrammed) {
+				err = -EAGAIN;
+				break;
+			}
 			continue;
 		}
 
-		if (stat & OMAP_I2C_STAT_XDR) {
+		/*
+		 * ProDB0017052: Clear ARDY bit twice. Handle it after RX
+		 * data-ready states so a combined ARDY|RRDY/RDR interrupt
+		 * cannot complete the transfer before payload bytes are copied.
+		 */
+		if (stat & OMAP_I2C_STAT_ARDY) {
+			omap_i2c_ack_stat(omap, OMAP_I2C_STAT_ARDY);
+			omap_i2c_ack_stat(omap, (OMAP_I2C_STAT_RRDY |
+						OMAP_I2C_STAT_RDR |
+						OMAP_I2C_STAT_XRDY |
+						OMAP_I2C_STAT_XDR |
+						OMAP_I2C_STAT_ARDY));
+			break;
+		}
+
+		if (!omap->receiver && (stat & OMAP_I2C_STAT_XDR)) {
 			u8 num_bytes = 1;
 			int ret;
 
@@ -1341,7 +1425,7 @@ static int omap_i2c_xfer_data(struct omap_i2c_dev *omap)
 			continue;
 		}
 
-		if (stat & OMAP_I2C_STAT_XRDY) {
+		if (!omap->receiver && (stat & OMAP_I2C_STAT_XRDY)) {
 			u8 num_bytes = 1;
 			int ret;
 
-- 
2.47.3
